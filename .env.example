# ========== 数据库（docker-compose 内置 PostgreSQL）==========
POSTGRES_USER=resume
POSTGRES_PASSWORD=resume
POSTGRES_DB=resume_review
# api 容器连接 db 服务的地址（compose 已有默认值，通常无需修改）
DATABASE_URL=postgresql+psycopg://resume:resume@db:5432/resume_review

# ========== LLM 服务（OpenAI 兼容接口）==========
# 注意：api 运行在容器内，localhost 指向容器自身。
# 若 LLM 部署在宿主机，请使用 http://host.docker.internal:8000/v1
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen2.5-72b-instruct
# 视觉模型（可选，留空则图片简历仅走 OCR 通道）
LLM_VLM_MODEL=
# 单次 LLM 请求超时（秒）
LLM_TIMEOUT=120

# ========== OCR 服务（PaddleOCR，需 --profile ocr 启动）==========
OCR_BASE_URL=http://ocr:8866
OCR_CONFIDENCE_THRESHOLD=0.85

# ========== 流水线行为 ==========
# 单个处理步骤（JD 分析/简历解析等）超时（秒）
STEP_TIMEOUT=120
# 简历并发处理数
MAX_CONCURRENCY=3
# 上传文件目录（容器内路径，对应 uploads 卷）
UPLOADS_DIR=./uploads
